# ==========================================
# TEMPLATE — copy to .env and fill in real values
# This file IS safe to commit. .env is gitignored.
# ==========================================

# SSH Target Credentials
SSH_HOST=192.168.x.x
SSH_PORT=22
SSH_USER=your_ssh_user
SSH_PASSWORD=your_ssh_password

# Database Configuration
POSTGRES_PASSWORD=your_db_password

# Auth — single-user login
APP_AUTH_USERNAME=your_dashboard_username
APP_AUTH_PASSWORD=your_strong_password_here

# JWT Secret — must be >= 32 random characters (HS256 minimum)
# Generate with: openssl rand -base64 48
JWT_SECRET=your_random_secret_at_least_32_chars_long
JWT_EXPIRATION_HOURS=24

# ─── Telegram Bot (Optional) ────────────────────────────────────────────────
# Configuration is stored in PostgreSQL (telegram_config table), NOT here.
# After the stack is running, configure via:  Settings → Telegram Integration
#
# Quick setup steps:
#   1. Message @BotFather on Telegram → /newbot → copy the token
#   2. Message @userinfobot to get your chat_id
#   3. Open the dashboard → Settings → Telegram → enter token + chat_id → SAVE
#   4. Click "SEND TEST" to verify connectivity
TELEGRAM_POLLING_ENABLED=false

# ─── Groq AI \u2014 Multi-Key Pool (9router-style rotation) ───────────────────────
# Get free keys at: https://console.groq.com/keys (up to 5 accounts)
# The system uses round-robin rotation + smart 60s cooldown on 429 rate limits.
# With N keys you get roughly N× the request capacity.
GROQ_API_KEY=gsk_your_primary_key_here
# GROQ_API_KEY_2=gsk_your_second_key_here
# GROQ_API_KEY_3=gsk_your_third_key_here
# GROQ_API_KEY_4=gsk_your_fourth_key_here
# GROQ_API_KEY_5=gsk_your_fifth_key_here
# GROQ_API_KEY_6=gsk_your_sixth_key_here
# GROQ_API_KEY_7=gsk_your_seventh_key_here
# GROQ_API_KEY_8=gsk_your_eighth_key_here
# GROQ_MODEL=openai/gpt-oss-120b
# ─── OpenRouter AI — Multi-Key Pool (Tier 2 Fallback, mirrors Groq pattern) ──
# Get free key at: https://openrouter.ai/keys (Access free models with :free tag)
# Add up to 5+ keys to increase OpenRouter request capacity.
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here
# OPENROUTER_API_KEY_2=sk-or-v1-your_second_key_here
# OPENROUTER_API_KEY_3=sk-or-v1-your_third_key_here
# OPENROUTER_API_KEY_4=sk-or-v1-your_fourth_key_here
# OPENROUTER_API_KEY_5=sk-or-v1-your_fifth_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
