{
  "properties": [
    {
      "name": "ssh.host",
      "type": "java.lang.String",
      "description": "Primary LAN SSH Host address."
    },
    {
      "name": "ssh.port",
      "type": "java.lang.Integer",
      "description": "Primary SSH Port."
    },
    {
      "name": "ssh.user",
      "type": "java.lang.String",
      "description": "SSH Username."
    },
    {
      "name": "ssh.password",
      "type": "java.lang.String",
      "description": "SSH Password."
    },
    {
      "name": "ssh.strict-host-key-checking",
      "type": "java.lang.String",
      "description": "SSH strict host key checking policy."
    },
    {
      "name": "ssh.fallback-host",
      "type": "java.lang.String",
      "description": "Fallback SSH Host (e.g. ngrok tunnel)."
    },
    {
      "name": "ssh.fallback-port",
      "type": "java.lang.Integer",
      "description": "Fallback SSH Port."
    },
    {
      "name": "app.jwt.secret",
      "type": "java.lang.String",
      "description": "JWT Signing Secret key."
    },
    {
      "name": "app.jwt.expiration-hours",
      "type": "java.lang.Integer",
      "description": "JWT token validity in hours."
    }
